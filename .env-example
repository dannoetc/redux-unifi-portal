# ReduxTC UniFi Captive Portal - example environment

# -------- Common --------
BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
DOMAIN=wifi.reduxtc.com
LETSENCRYPT_EMAIL=ops@reduxtc.com

# -------- Backend core --------
# Docker Compose network (recommended for Docker-only)
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/redux_portal
REDIS_URL=redis://redis:6379/0
SECRET_KEY=dev-change-me
# Required for encrypting UniFi/OIDC secrets stored in the database.
# Generate with:
#   docker compose run --rm api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=replace-with-fernet-key
LOG_LEVEL=INFO
SENTRY_DSN=
CORS_ALLOW_ORIGINS=http://localhost:3000

# -------- Admin sessions --------
ADMIN_SESSION_MAX_AGE_SECONDS=43200
ADMIN_SESSION_COOKIE_SECURE=false

# -------- OTP + rate limits --------
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_SECONDS=60
OTP_RATE_LIMIT_PER_IP=5
OTP_RATE_LIMIT_PER_MAC=5
OTP_VERIFY_RATE_LIMIT_PER_IP=10
OTP_VERIFY_RATE_LIMIT_PER_MAC=10

# -------- Voucher rate limits --------
VOUCHER_RATE_LIMIT_WINDOW_SECONDS=60
VOUCHER_RATE_LIMIT_PER_IP=10
VOUCHER_RATE_LIMIT_PER_MAC=10

# -------- OIDC --------
OIDC_STATE_TTL_SECONDS=600

# -------- Celery --------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# -------- Email (OTP) --------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=wifi@reduxtc.com
SMTP_FROM_NAME=ReduxTC WiFi

# -------- UniFi --------
UNIFI_VERIFY_SSL=true
UNIFI_CLIENT_LOOKUP_ATTEMPTS=6
UNIFI_CLIENT_LOOKUP_BACKOFF_SECONDS=0.6


# -------- Seed script (optional) --------
SUPERADMIN_EMAIL=jhalon@reduxtc.com
SUPERADMIN_PASSWORD=change-me
TENANT_SLUG=acme
TENANT_NAME="Acme MSP"
SITE_SLUGS=lab,office,guest,warehouse
SITE_DISPLAY_NAMES=Lab,Office,Guest,Warehouse
SITE_UNIFI_SITE_IDS=default,default,default,default
UNIFI_BASE_URL=https://unifi.local
UNIFI_API_KEY=replace-with-unifi-api-key
DEFAULT_TIME_LIMIT_MINUTES=60
DEFAULT_DATA_LIMIT_MB=500
DEFAULT_RX_KBPS=2000
DEFAULT_TX_KBPS=2000
